# Masters and originals stay local only (owner rule): never commit them.
*.psd
*.ttf
*.otf
source/
originals/

# OS and editor junk
.DS_Store

# CI artifact index (tools/ci/qa-artifact-index.js, docs/100): a CI output, never committed
game/qa/ci_artifact_index_*.json
qa-failure-screenshots/

# QA screenshots are run output, regenerated by every suite and kept by CI as 1-day artifacts
# (docs/100). No test reads a committed copy, so none are committed.
game/qa/*screenshots/
tools/*/qa/screenshots/
