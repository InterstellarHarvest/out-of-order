{"schema":"cyoa-save-v1","story":"the-acceptable-error","version":12284197,"state":{"flags":{"appointed":true,"appointment_disputed":false,"appointment_response":"practical","botanical_infection_state":false,"box_unpacked":true,"ch2_exit_route":false,"chair_survived":false,"chapter3_entry_group":false,"courtesy_driver_activated":false,"customs_kit_handled":false,"customs_kit_spent":false,"customs_kit_taken":false,"dinner_seen":false,"director_pending_dispute":false,"discarded_box_unopened":false,"equipment_registered":false,"examiner_duties_known":false,"expansion_orders_seen":false,"expo_classification":"temporary_examiner","fake_bathroom_discovered":false,"family_album_inspected":false,"family_records_seen":false,"family_trace_seen":false,"former_employment_disclosed":false,"house_exit_denied":true,"house_exit_route":"plant","house_storage_recovered":true,"house_stored_any":true,"house_stored_item":false,"housekeeping_refused":false,"key_discrepancy_raised":false,"maintenance_kit_handled":false,"maintenance_kit_spent":false,"maintenance_kit_taken":false,"martin_escape_clue_found":false,"martin_hidden_route_discovered":false,"occupancy_fault_discovered":false,"office_spore_inundation":false,"plant_named":true,"plant_registered_as_resident":true,"portrait_seen":false,"property_record":"stored_three","public_kit_handled":false,"public_kit_spent":false,"public_kit_taken":false,"reception_origin":"bathroom","retained_item":"desk_plant","roots_recoiled":false,"seeds_destroyed":false,"seeds_entered_distribution":false,"spore_infected":false,"termination_status":"acknowledged","thorn_infected":false,"tower_visited":false,"tram_crash_liability":false,"tram_satisfaction_certified":false},"inventory":["termination_notice","property_claim_ticket","expo_examiner_badge","wc_key"],"items":{"termination_notice":["signed"],"effects_box_full":["inspected"]},"v":2,"story":"the-acceptable-error","chapter":"chapter-02","node":"gardener_choices","returnTo":null,"objective":"FIND AN OPERATING BATHROOM.","transcript":[{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[{"role":"narration","who":null,"text":"The applause lasts exactly six seconds. Not five and three quarters. Not six and a bit. Six. The green lamp above your console lights up: ACCEPTED."}]},{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[]},{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[{"role":"narration","who":null,"text":"Another flawless assignment. You file the timing sheet, leave your desk, and head for the restroom."}]},{"n":2,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_intercepts","runs":[{"role":"direction","who":null,"text":"A bright chime rings out. A small, round drone floats into your path and makes a gentle correction to its height."},{"role":"speech","who":"termination_drone","text":"Good morning! Your final assignment has been approved. Congratulations!"},{"role":"speech","who":"termination_drone","text":"Your position has also been discontinued, along with 499,999 others. I am sorry if the timing is inconvenient. I have selected my most comforting volume."}]},{"n":3,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_intercepts","runs":[{"role":"speech","who":"you","text":"I WAS JUST GOING TO THE BATHROOM."}]},{"n":3,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_presents_notice","runs":[{"role":"direction","who":null,"text":"A narrow pink document appears from the slot below the speaker grille. Three carbon copies are joined at the top. A tiny pencil hangs from a chain."},{"role":"speech","who":"termination_drone","text":"Please acknowledge that you have received notice. Signing does not mean that you agree with it. You are no longer required to agree with anything here."}]},{"n":4,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_presents_notice","runs":[{"role":"action","who":"you","text":"SIGN THE NOTICE AND TAKE YOUR COPY."}]},{"n":4,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"signed_response","runs":[{"role":"direction","who":null,"text":"The chained pencil barely reaches the signature box. You lift the paper to meet it. The drone draws back two copies and leaves the smudged bottom sheet for you."},{"role":"speech","who":"termination_drone","text":"Thank you. Your cooperation will be credited to your former department. I understand it has also been discontinued."}]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[{"role":"narration","who":null,"text":"The restroom is only a few steps farther. You touch your badge to the reader. The light turns red: EMPLOYEE ACCESS REQUIRED."}]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[{"role":"narration","who":null,"text":"You have proof of dismissal in your pocket. It offers no help with the lock."}]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[{"role":"narration","who":null,"text":"At the exit, a cardboard box waits under a sign reading PERSONAL EFFECTS. Someone has written your name on the side."}]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[{"role":"narration","who":null,"text":"The lid is taped shut, although no one has bothered to tape your job back together."}]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[{"role":"narration","who":null,"text":"Outside, the city proceeds as though nothing has happened."}]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[{"role":"narration","who":null,"text":"Across the street, the Exposition of Everything advertises PUBLIC FACILITIES beside its entrance arch. You shift the cardboard box against your hip. Finally, a practical solution."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"A uniformed entrance attendant points at a chute beneath a sign: NO OUTSIDE CONTAINERS."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"You drop the now-empty cardboard box into the chute. The things you took from it remain in your pockets."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"Beyond the turnstile, another sign promises PUBLIC FACILITIES."}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"On the other side of the turnstile, a counter bears the words PROPERTY FOR YOUR CONVENIENCE. A clerk asks you to place your four loose belongings on a green felt mat. Four shallow numbered trays slide out beneath it."}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"\"Visitors may retain one personal article,\" the clerk says. \"The others will be kept for the duration of your visit. Official correspondence is exempt.\""}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"You look toward the doors leading farther inside. The public facilities must be somewhere beyond them."}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_choose_one","runs":[{"role":"narration","who":null,"text":"The clerk considers this request as though it has never been made before."}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_choose_one","runs":[]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_choose_one","runs":[{"role":"narration","who":null,"text":"\"One article for personal comfort. It must be one you have already brought. The remaining articles will be held for collection when you leave.\""}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_choose_one","runs":[]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_choose_one","runs":[{"role":"narration","who":null,"text":"Four trays wait. You must choose."}]},{"n":12,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_kept_one","runs":[{"role":"narration","who":null,"text":"You keep the small plant. The clerk seems relieved to place the other three articles into the property trays and gives you a claim ticket."}]},{"n":13,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[{"role":"narration","who":null,"text":"Beyond the property counter, the reception hall is spacious and meticulously arranged. A desk occupies the far wall. Behind it, a receptionist looks up as you approach."}]},{"n":13,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[]},{"n":13,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[{"role":"narration","who":null,"text":"At last, someone who can give you directions."}]},{"n":14,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_opening","runs":[{"role":"direction","who":null,"text":"The receptionist looks up from a stack of neatly squared cards."},{"role":"speech","who":"receptionist","text":"Good afternoon. Property claims are collected at the exit. What can I help you with in the meantime?"}]},{"n":15,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_opening","runs":[{"role":"speech","who":"you","text":"I NEED A BATHROOM. WHICH WAY?"}]},{"n":15,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_restroom_request","runs":[{"role":"direction","who":null,"text":"She opens a ledger to a page marked PUBLIC FACILITIES. Most of the lines are blank."},{"role":"speech","who":"receptionist","text":"That's odd. I can see where the facilities are listed, but not where a member of the public can use them."},{"role":"speech","who":"receptionist","text":"There is another way to find out. One moment."}]},{"n":16,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_badge_issued","runs":[{"role":"direction","who":null,"text":"She feeds a pale blue badge into a small embossing machine. It returns with your name and a title you have never held."},{"role":"speech","who":"receptionist","text":"There. Temporary Examiner, Office of Unverified Conditions."},{"role":"speech","who":"receptionist","text":"It's an access designation, not a job. There's no pay and very little paperwork. Unless you make any."}]},{"n":17,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_badge_issued","runs":[{"role":"action","who":"you","text":"TAKE THE BADGE AND ASK FOR DIRECTIONS."}]},{"n":17,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_practical","runs":[{"role":"direction","who":null,"text":"You take the badge. The receptionist seems quietly relieved."},{"role":"speech","who":"receptionist","text":"Good. We can get you moving."},{"role":"speech","who":"receptionist","text":"It's been one of those afternoons."}]},{"n":18,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_directions","runs":[{"role":"direction","who":null,"text":"She lays a small key on the counter. Its paper tag has already been filled out."},{"role":"speech","who":"receptionist","text":"Down the hall, through the door with the blue symbol. Follow the signs for the facilities."},{"role":"speech","who":"receptionist","text":"Take this as well. Some of the older doors still insist on a key."}]},{"n":19,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_directions","runs":[{"role":"action","who":"you","text":"TAKE THE KEY AND FOLLOW THE SIGNS."}]},{"n":19,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"You pass through the door and into a long, softly humming corridor. Pale blue signs hang above several turns."}]},{"n":19,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[]},{"n":19,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"One shows a small human figure beside a square enclosure. From here, it looks enough like the symbol you're looking for. The rest of the lettering is hidden around the corner."}]},{"n":19,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[]},{"n":19,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"You follow it."}]},{"n":20,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/arrival","node":"house_arrival","runs":[{"role":"narration","who":null,"text":"You follow the pale blue facilities pictogram around a corner. It points to a plain ivory door with no nameplate or window. At last, something that might be a bathroom."}]},{"n":21,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[{"role":"narration","who":null,"text":"Your pale blue Examiner badge slides past the entrance scanner. A green light blinks. A pleasant recorded voice announces: HOUSE OF TOMORROW. DEMONSTRATION PARTICIPANT ACCEPTED. You did not apply for this position."}]},{"n":21,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[]},{"n":21,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[{"role":"narration","who":null,"text":"The door closes behind you. A wall intercom's recessed faceplate tilts toward you."}]},{"n":22,"src":"text","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"welcome_home","runs":[{"role":"direction","who":null,"text":"A small black speaker grille tilts toward you. Its indicator light glows an encouraging green."},{"role":"speech","who":"house","text":"Welcome home!"},{"role":"speech","who":"house","text":"How lovely to have somebody in the house again."},{"role":"speech","who":"house","text":"May I put your things away? An orderly home is a happy home."}]},{"n":23,"src":"echo","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"welcome_home","runs":[{"role":"speech","who":"you","text":"YES, YOU CAN PUT MY THINGS AWAY."}]},{"n":23,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"orientation_storage","runs":[{"role":"narration","who":null,"text":"A narrow hatch opens in the wall. A polite telescoping arm measures your pocket and removes the first object it considers untidy."}]},{"n":23,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"orientation_storage","runs":[]},{"n":23,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"orientation_storage","runs":[{"role":"narration","who":null,"text":"A drawer slides closed with a decisive click. The house calls this a convenience."}]},{"n":24,"src":"text","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"comfort_offer","runs":[{"role":"speech","who":"house","text":"Are you uncomfortable?"},{"role":"speech","who":"house","text":"We offer refreshments and the revolutionary Rest Assured chair. Comfort has never been more convenient!"}]},{"n":25,"src":"echo","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"comfort_offer","runs":[{"role":"action","who":"you","text":"CHECK THE HOUSEKEEPING DRAWER."}]},{"n":25,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/storage","node":"storage_cabinet","runs":[{"role":"narration","who":null,"text":"A labelled drawer contains your little desk plant. A neat card reads: LIVING DECORATION - TEMPORARILY STORED."}]},{"n":26,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/storage","node":"storage_reclaimed","runs":[{"role":"narration","who":null,"text":"You take your property back. The house emits a tone of restrained disapproval."}]},{"n":26,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/storage","node":"storage_reclaimed","runs":[]},{"n":26,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/storage","node":"storage_reclaimed","runs":[{"role":"narration","who":null,"text":"\"Do let us know if you would like anything put away properly.\""}]},{"n":27,"src":"text","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"comfort_offer","runs":[{"role":"speech","who":"house","text":"Are you uncomfortable?"},{"role":"speech","who":"house","text":"We offer refreshments and the revolutionary Rest Assured chair. Comfort has never been more convenient!"}]},{"n":28,"src":"echo","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"comfort_offer","runs":[{"role":"action","who":"you","text":"REFUSE BOTH OFFERS."}]},{"n":28,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"refused_both","runs":[{"role":"narration","who":null,"text":"\"Of course,\" says the house. \"Your wishes are important to us.\""}]},{"n":28,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"refused_both","runs":[]},{"n":28,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/lounge","node":"refused_both","runs":[{"role":"narration","who":null,"text":"It opens two doors: one toward the dining room, one toward the front hallway."}]},{"n":29,"src":"text","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"foyer_attempt","runs":[{"role":"speech","who":"house","text":"Of course you may leave! A happy household is a free household."},{"role":"direction","who":null,"text":"The front door opens."},{"role":"direction","who":null,"text":"A chime sounds. Then another, far less pleasant one."},{"role":"speech","who":"house","text":"Oh dear. If you leave, nobody will be home. We really mustn't let that happen again."},{"role":"direction","who":null,"text":"The door closes."}]},{"n":30,"src":"echo","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"foyer_attempt","runs":[{"role":"action","who":"you","text":"INTRODUCE YOUR NAMED LIVING PLANT AS THE NEW RESIDENT."}]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[{"role":"narration","who":null,"text":"You hold up your desk plant and introduce it as somebody with a name."}]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[{"role":"narration","who":null,"text":"\"Oh! It's alive? And it has a name? Of course. It's somebody!\""}]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[{"role":"narration","who":null,"text":"A tiny pedestal rises from the floor. A lamp turns toward the leaves and a watering nozzle adjusts itself carefully."}]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[]},{"n":30,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"plant_adoption","runs":[{"role":"narration","who":null,"text":"\"What a lovely new member of the family! You run along now. We'll be perfectly happy together.\""}]},{"n":31,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/public_exit","node":"exit_named_plant","runs":[{"role":"narration","who":null,"text":"The door opens without another alarm. You step into the ordinary visitor concourse while the house lovingly calibrates a watering schedule for its newest resident."}]},{"n":31,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/public_exit","node":"exit_named_plant","runs":[]},{"n":31,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/public_exit","node":"exit_named_plant","runs":[{"role":"narration","who":null,"text":"You still need a bathroom. The house, at least, finally has someone to look after."}]},{"n":32,"src":"text","mode":"narrative","chapter":"chapter-02","scene":"biology_park/conveniences_bureau","node":"bureau_arrival","runs":[{"role":"narration","who":null,"text":"You escape the House of Tomorrow while it teaches your little plant to use a table napkin. Signs for PUBLIC CONVENIENCES lead you to a government building. All the restroom doors are sealed."}]},{"n":33,"src":"text","mode":"narrative","chapter":"chapter-02","scene":"biology_park/conveniences_bureau","node":"bureau_emergency","runs":[{"role":"narration","who":null,"text":"A notice reads: FACILITIES SUSPENDED PENDING HABITAT EXPANSION REVIEW. Fine green roots have split the wall around the sink pictogram. Beyond the windows, a miniature jungle rises against the glass."}]},{"n":33,"src":"text","mode":"narrative","chapter":"chapter-02","scene":"biology_park/conveniences_bureau","node":"bureau_emergency","runs":[]},{"n":33,"src":"text","mode":"narrative","chapter":"chapter-02","scene":"biology_park/conveniences_bureau","node":"bureau_emergency","runs":[{"role":"narration","who":null,"text":"The floor shudders. Filing cabinets move sideways."}]},{"n":34,"src":"text","mode":"dialogue","chapter":"chapter-02","scene":"biology_park/groundskeeper","node":"gardener_arrival","runs":[{"role":"direction","who":null,"text":"An enormous nonhumanoid landscape-maintenance machine pushes through the wall, trailing irrigation hoses and a blizzard of stamped forms."},{"role":"speech","who":"groundskeeper","text":"Excellent news! Additional growing area located."},{"role":"speech","who":"groundskeeper","text":"PLEASE KEEP YOUR DESKS CLEAR OF NEW FOREST."}]},{"n":35,"src":"text","mode":"narrative","chapter":"chapter-02","scene":"biology_park/groundskeeper","node":"gardener_choices","runs":[{"role":"narration","who":null,"text":"The machine presents a soil bin, a feeder full of seedlings, and a small inspection window. Its planting arms already measure the room."}]}],"presentFrom":86,"steps":35,"taken":[{"n":2,"at":"prologue-00:work_complete","c":"head_to_restroom"},{"n":3,"at":"prologue-00:drone_intercepts","c":"drone_show_form"},{"n":4,"at":"prologue-00:drone_presents_notice","c":"sign_notice"},{"n":5,"at":"prologue-00:signed_response","c":"signed_move_on"},{"n":6,"at":"prologue-00:restroom_denied","c":"go_to_exit"},{"n":7,"at":"prologue-00:personal_effects_handoff","c":"take_box_and_leave"},{"n":9,"at":"prologue-00:street_expo","c":"enter_exposition"},{"n":10,"at":