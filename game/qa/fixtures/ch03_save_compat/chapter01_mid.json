{"schema":"cyoa-save-v1","story":"the-acceptable-error","version":12284197,"state":{"flags":{"appointed":true,"appointment_disputed":false,"appointment_response":"practical","botanical_infection_state":false,"box_unpacked":true,"ch2_exit_route":false,"chair_survived":false,"chapter3_entry_group":false,"courtesy_driver_activated":false,"customs_kit_handled":false,"customs_kit_spent":false,"customs_kit_taken":false,"dinner_seen":false,"director_pending_dispute":false,"discarded_box_unopened":false,"equipment_registered":false,"examiner_duties_known":false,"expansion_orders_seen":false,"expo_classification":"temporary_examiner","fake_bathroom_discovered":false,"family_album_inspected":false,"family_records_seen":false,"family_trace_seen":false,"former_employment_disclosed":false,"house_exit_denied":false,"house_exit_route":false,"house_storage_recovered":false,"house_stored_any":false,"house_stored_item":false,"housekeeping_refused":false,"key_discrepancy_raised":false,"maintenance_kit_handled":false,"maintenance_kit_spent":false,"maintenance_kit_taken":false,"martin_escape_clue_found":false,"martin_hidden_route_discovered":false,"occupancy_fault_discovered":false,"office_spore_inundation":false,"plant_named":false,"plant_registered_as_resident":false,"portrait_seen":false,"property_record":"stored_all","public_kit_handled":false,"public_kit_spent":false,"public_kit_taken":false,"reception_origin":"bathroom","retained_item":false,"roots_recoiled":false,"seeds_destroyed":false,"seeds_entered_distribution":false,"spore_infected":false,"termination_status":"acknowledged","thorn_infected":false,"tower_visited":false,"tram_crash_liability":false,"tram_satisfaction_certified":false},"inventory":["termination_notice","property_claim_ticket","expo_examiner_badge","wc_key"],"items":{"termination_notice":["signed"],"effects_box_full":["inspected"]},"v":2,"story":"the-acceptable-error","chapter":"chapter-01","node":"welcome_home","returnTo":"badge_registration","objective":"FIND A FUNCTIONING BATHROOM.","transcript":[{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[{"role":"narration","who":null,"text":"The applause lasts exactly six seconds. Not five and three quarters. Not six and a bit. Six. The green lamp above your console lights up: ACCEPTED."}]},{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[]},{"n":1,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/applause_station","node":"work_complete","runs":[{"role":"narration","who":null,"text":"Another flawless assignment. You file the timing sheet, leave your desk, and head for the restroom."}]},{"n":2,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_intercepts","runs":[{"role":"direction","who":null,"text":"A bright chime rings out. A small, round drone floats into your path and makes a gentle correction to its height."},{"role":"speech","who":"termination_drone","text":"Good morning! Your final assignment has been approved. Congratulations!"},{"role":"speech","who":"termination_drone","text":"Your position has also been discontinued, along with 499,999 others. I am sorry if the timing is inconvenient. I have selected my most comforting volume."}]},{"n":3,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_intercepts","runs":[{"role":"speech","who":"you","text":"I WAS JUST GOING TO THE BATHROOM."}]},{"n":3,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_presents_notice","runs":[{"role":"direction","who":null,"text":"A narrow pink document appears from the slot below the speaker grille. Three carbon copies are joined at the top. A tiny pencil hangs from a chain."},{"role":"speech","who":"termination_drone","text":"Please acknowledge that you have received notice. Signing does not mean that you agree with it. You are no longer required to agree with anything here."}]},{"n":4,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"drone_presents_notice","runs":[{"role":"action","who":"you","text":"SIGN THE NOTICE AND TAKE YOUR COPY."}]},{"n":4,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"workplace/corridor","node":"signed_response","runs":[{"role":"direction","who":null,"text":"The chained pencil barely reaches the signature box. You lift the paper to meet it. The drone draws back two copies and leaves the smudged bottom sheet for you."},{"role":"speech","who":"termination_drone","text":"Thank you. Your cooperation will be credited to your former department. I understand it has also been discontinued."}]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[{"role":"narration","who":null,"text":"The restroom is only a few steps farther. You touch your badge to the reader. The light turns red: EMPLOYEE ACCESS REQUIRED."}]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[]},{"n":5,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/corridor","node":"restroom_denied","runs":[{"role":"narration","who":null,"text":"You have proof of dismissal in your pocket. It offers no help with the lock."}]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[{"role":"narration","who":null,"text":"At the exit, a cardboard box waits under a sign reading PERSONAL EFFECTS. Someone has written your name on the side."}]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[]},{"n":6,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"workplace/exit","node":"personal_effects_handoff","runs":[{"role":"narration","who":null,"text":"The lid is taped shut, although no one has bothered to tape your job back together."}]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[{"role":"narration","who":null,"text":"Outside, the city proceeds as though nothing has happened."}]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[]},{"n":7,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"street/outside_workplace","node":"street_expo","runs":[{"role":"narration","who":null,"text":"Across the street, the Exposition of Everything advertises PUBLIC FACILITIES beside its entrance arch. You shift the cardboard box against your hip. Finally, a practical solution."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"A uniformed entrance attendant points at a chute beneath a sign: NO OUTSIDE CONTAINERS."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"You drop the now-empty cardboard box into the chute. The things you took from it remain in your pockets."}]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[]},{"n":9,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/entrance","node":"expo_container_check","runs":[{"role":"narration","who":null,"text":"Beyond the turnstile, another sign promises PUBLIC FACILITIES."}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"On the other side of the turnstile, a counter bears the words PROPERTY FOR YOUR CONVENIENCE. A clerk asks you to place your four loose belongings on a green felt mat. Four shallow numbered trays slide out beneath it."}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"\"Visitors may retain one personal article,\" the clerk says. \"The others will be kept for the duration of your visit. Official correspondence is exempt.\""}]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[]},{"n":10,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_property_counter","runs":[{"role":"narration","who":null,"text":"You look toward the doors leading farther inside. The public facilities must be somewhere beyond them."}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_stored_all","runs":[{"role":"narration","who":null,"text":"The clerk deposits your belongings into the four numbered trays. The trays vanish beneath the counter with a series of identical clicks."}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_stored_all","runs":[]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_stored_all","runs":[{"role":"narration","who":null,"text":"A thin claim ticket is placed in your hand. Its heading reads: COLLECTION ON DEPARTURE. No departure time is printed."}]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_stored_all","runs":[]},{"n":11,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/property_intake","node":"expo_stored_all","runs":[{"role":"narration","who":null,"text":"\"For your convenience,\" the clerk repeats, already looking past you."}]},{"n":12,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[{"role":"narration","who":null,"text":"Beyond the property counter, the reception hall is spacious and meticulously arranged. A desk occupies the far wall. Behind it, a receptionist looks up as you approach."}]},{"n":12,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[]},{"n":12,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/reception","node":"expo_reception_handoff","runs":[{"role":"narration","who":null,"text":"At last, someone who can give you directions."}]},{"n":13,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_opening","runs":[{"role":"direction","who":null,"text":"The receptionist looks up from a stack of neatly squared cards."},{"role":"speech","who":"receptionist","text":"Good afternoon. Property claims are collected at the exit. What can I help you with in the meantime?"}]},{"n":14,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_opening","runs":[{"role":"speech","who":"you","text":"I NEED A BATHROOM. WHICH WAY?"}]},{"n":14,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_restroom_request","runs":[{"role":"direction","who":null,"text":"She opens a ledger to a page marked PUBLIC FACILITIES. Most of the lines are blank."},{"role":"speech","who":"receptionist","text":"That's odd. I can see where the facilities are listed, but not where a member of the public can use them."},{"role":"speech","who":"receptionist","text":"There is another way to find out. One moment."}]},{"n":15,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_badge_issued","runs":[{"role":"direction","who":null,"text":"She feeds a pale blue badge into a small embossing machine. It returns with your name and a title you have never held."},{"role":"speech","who":"receptionist","text":"There. Temporary Examiner, Office of Unverified Conditions."},{"role":"speech","who":"receptionist","text":"It's an access designation, not a job. There's no pay and very little paperwork. Unless you make any."}]},{"n":16,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_badge_issued","runs":[{"role":"action","who":"you","text":"TAKE THE BADGE AND ASK FOR DIRECTIONS."}]},{"n":16,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_practical","runs":[{"role":"direction","who":null,"text":"You take the badge. The receptionist seems quietly relieved."},{"role":"speech","who":"receptionist","text":"Good. We can get you moving."},{"role":"speech","who":"receptionist","text":"It's been one of those afternoons."}]},{"n":17,"src":"text","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_directions","runs":[{"role":"direction","who":null,"text":"She lays a small key on the counter. Its paper tag has already been filled out."},{"role":"speech","who":"receptionist","text":"Down the hall, through the door with the blue symbol. Follow the signs for the facilities."},{"role":"speech","who":"receptionist","text":"Take this as well. Some of the older doors still insist on a key."}]},{"n":18,"src":"echo","mode":"dialogue","chapter":"prologue-00","scene":"exposition/reception","node":"reception_directions","runs":[{"role":"action","who":"you","text":"TAKE THE KEY AND FOLLOW THE SIGNS."}]},{"n":18,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"You pass through the door and into a long, softly humming corridor. Pale blue signs hang above several turns."}]},{"n":18,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[]},{"n":18,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"One shows a small human figure beside a square enclosure. From here, it looks enough like the symbol you're looking for. The rest of the lettering is hidden around the corner."}]},{"n":18,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[]},{"n":18,"src":"text","mode":"narrative","chapter":"prologue-00","scene":"exposition/facilities_corridor","node":"reception_hallway","runs":[{"role":"narration","who":null,"text":"You follow it."}]},{"n":19,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/arrival","node":"house_arrival","runs":[{"role":"narration","who":null,"text":"You follow the pale blue facilities pictogram around a corner. It points to a plain ivory door with no nameplate or window. At last, something that might be a bathroom."}]},{"n":20,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[{"role":"narration","who":null,"text":"Your pale blue Examiner badge slides past the entrance scanner. A green light blinks. A pleasant recorded voice announces: HOUSE OF TOMORROW. DEMONSTRATION PARTICIPANT ACCEPTED. You did not apply for this position."}]},{"n":20,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[]},{"n":20,"src":"text","mode":"narrative","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"badge_registration","runs":[{"role":"narration","who":null,"text":"The door closes behind you. A wall intercom's recessed faceplate tilts toward you."}]},{"n":21,"src":"text","mode":"dialogue","chapter":"chapter-01","scene":"house_of_tomorrow/foyer","node":"welcome_home","runs":[{"role":"direction","who":null,"text":"A small black speaker grille tilts toward you. Its indicator light glows an encouraging green."},{"role":"speech","who":"house","text":"Welcome home!"},{"role":"speech","who":"house","text":"How lovely to have somebody in the house again."},{"role":"speech","who":"house","text":"May I put your things away? An orderly home is a happy home."}]}],"presentFrom":52,"steps":21,"taken":[{"n":2,"at":"prologue-00:work_complete","c":"head_to_restroom"},{"n":3,"at":"prologue-00:drone_intercepts","c":"drone_show_form"},{"n":4,"at":"prologue-00:drone_presents_notice","c":"sign_notice"},{"n":5,"at":"prologue-00:signed_response","c":"signed_move_on"},{"n":6,"at":"prologue-00:restroom_denied","c":"go_to_exit"},{"n":7,"at":"prologue-00:personal_effects_handoff","c":"take_box_and_leave"},{"n":9,"at":"prologue-00:street_expo","c":"enter_exposition"},{"n":10,"at":"prologue-00:expo_container_check","c":"pass_turnstile"},{"n":11,"at":"prologue-00:expo_property_counter","c":"deposit_all"},{"n":12,"at":"prologue-00:expo_stored_all","c":"continue_to_reception_stored"},{"n":13,"at":"prologue-00:expo_reception_handoff","c":"speak_to_receptionist"},{"n":14,"at":"prologue-00:reception_opening","c":"ask_for_restroom"},{"n":15,"at":"prologue-00:reception_restroom_request","c":"wait_for_assistance"},{"n":16,"at":"prologue-00:reception_badge_issued","c":"accept_for_directions"},{"n":17,"at":"prologue-00:reception_practical","c":"move_on_practical"},{"n":18,"at":"prologue-00:reception_directions","c":"leave_reception"},{"n":19,"at":"prologue-00:reception_hallway","c":"continue_to_chapter_01"},{"n":20,"at":"chapter-01:house_arrival","c":"enter_show_home"},{"n":21,"at":"chapter-01:badge_registration","c":"hear_house_greeting"}],"contextDone":[],"checks":{},"seed":"1"},"cursor":{"presented":53}}
